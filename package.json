{
  "name": "@urban/agentic-memory-mono",
  "version": "0.4.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "oxlint --fix && oxfmt",
    "prepare": "husky",
    "start:llama": "llama-server --hf-repo Qwen/Qwen3-4B-GGUF --hf-file Qwen3-4B-Q4_K_M.gguf --host 127.0.0.1 --port 8080 --alias agentic-memory-qwen3-4b --ctx-size 16384 --jinja --reasoning off --n-gpu-layers 99",
    "test": "bun --filter='./packages/*' run test",
    "typecheck": "bun --filter='./packages/*' run typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@effect/tsgo": "0.24.2",
    "@effect/vitest": "4.0.0-beta.100",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "husky": "9.1.7",
    "lint-staged": "17.1.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{css,html,json,jsonc,md,mdx,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">= 24.12.0"
  },
  "packageManager": "bun@1.3.5"
}
