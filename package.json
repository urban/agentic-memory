{
  "name": "@urban/agentic-memory-mono",
  "version": "0.4.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "oxlint --fix && oxfmt",
    "prepare": "husky && effect-tsgo patch && effect-language-service patch",
    "setup:zed-effect-tsgo": "bash scripts/setup-zed-effect-tsgo.sh",
    "test": "bun --filter='./packages/*' run test",
    "typecheck": "bun --filter='./packages/*' run typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@effect/language-service": "0.86.4",
    "@effect/tsgo": "0.16.0",
    "@effect/vitest": "4.0.0-beta.93",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260706.1",
    "@vitest/coverage-v8": "4.1.10",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "typescript": "latest",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{css,html,json,jsonc,md,mdx,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">= 24.12.0"
  },
  "packageManager": "bun@1.3.5"
}
